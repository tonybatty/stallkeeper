            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/checkouts/{{checkoutId}}/sdk-cancel",
            "description": "What the page sends when the PayPal SDK reports a cancel. Reads the order from PayPal first and captures it if PayPal has it approved, otherwise releases the checkout. The Cancel checkout button uses the route above, which never captures. The original buyer cookie must match.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Owner feed and closing",
      "item": [
        {
          "name": "Feed snapshot",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/owner/feed",
            "description": ""
          },
          "response": []
        },
        {
          "name": "Recheck flagged payment",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/owner/checkouts/{{checkoutId}}/recheck",
            "description": "Owner cookie required. Choose a flagged checkout from the feed. Reads PayPal evidence and may update payment state; 409 if no review is required. A successful check does not necessarily resolve the payment."
          },
          "response": []
        },
        {
          "name": "Feed updates - long-lived SSE",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/owner/feed/stream",
            "description": "Manual streaming request. Cancel it to end the connection. Owner cookie required; exclude from a sequential collection run."
          },
          "response": []
        },
        {
          "name": "Close trading session",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/owner/stall/close",
            "description": "Stops new reservations. Existing checkouts keep their original deadline."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set(\"sessionId\", data.sessionId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Read closing report",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/owner/closing",
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  if (data.closing) pm.collectionVariables.set(\"sessionId\", data.closing.sessionId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Write closing summary",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/owner/closing/summary",
            "description": "Asks the model for a neutral summary of the structured closing report. Spends model tokens against the daily cap, unless the report is unchanged since the saved summary, which comes back with no model call. The summary is null when no model is configured, the model fails, the cap is reached or the check refuses its figures or wording; the report is unaffected. On the published demo stall only, the response also carries a `trace`: the outcome, the refusal rule, the finish reason, and input and output tokens. It never carries the model's text."
          },
          "response": []
        },
        {
          "name": "Check closing with PayPal",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/owner/closing/paypal-check",
            "description": "Reads this stall's sandbox orders with the PayPal Agent Toolkit and compares them with the recorded totals. Read-only. The transaction listing part needs Transaction Search enabled on the PayPal app."
          },
          "response": []
        },
        {
          "name": "Record closing exception",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/owner/closing/shelf-check",
            "description": "Optional. Use absent to flag an unsold item as not at the stall, and unknown to clear the flag. Removed requires a reason. Removing takes the item off sale unless payment holds it; correcting a removal can restore it unless a completed capture exists.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"itemId\": \"{{itemId}}\",\n  \"observation\": \"unknown\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Read charity pledge",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/owner/stall/charity",
            "description": "Returns the stall's charity pledge, or null, sessionFixed, true when the open session has a recorded sale and so keeps its own pledge, and donateButton, true when this server has a Donate button ID. The demo stall has no pledge, so this returns null there."
          },
          "response": []
        },
        {
          "name": "Set charity pledge",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/owner/stall/charity",
            "description": "Sets the charity name and a whole-number percentage from 1 to 100. Buyers then see one line on item pages and the closing report works out the pledged amount from recorded sales after refunds. The change reaches an open session only until its first recorded sale. After that it saves for the next session and sessionFixed is true. A closing or closed session never takes the change, and sessionFixed is false because it describes only an open session.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Garden Rescue\",\n  \"percent\": 10\n}"
            }
          },
          "response": []
        },
        {
          "name": "Remove charity pledge",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/owner/stall/charity",
            "description": "Removes the pledge from the stall, and from an open session with no recorded sale. A session with a recorded sale, or a closing or closed session, keeps its pledge and its recorded donations, and a donation can still be recorded against it once it has closed."
          },
          "response": []
        },
        {
          "name": "Record Donate button result",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/owner/closing/donation",
            "description": "Records what PayPal's Donate button reported for a closing session. It writes a donation row only and changes no sales figure. Use a real sandbox transaction ID from the Donate pop-up; the API cannot check it against PayPal. A status other than Completed or an unreadable amount returns 422 and records nothing. A session that is still open or never carried a pledge returns 409. Returns 429 after 20 recorded donations an hour for a stall; a repeated transaction ID records nothing and is not counted.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"transactionId\": \"SANDBOXTX123\",\n  \"status\": \"Completed\",\n  \"amount\": \"2.80\",\n  \"currency\": \"GBP\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Stall ledger data",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/owner/ledger/data",
            "description": "Every session, ledger row, offer and item for the logged-in stall, plus today's service-wide AI spend against the daily cap. Holds no floors, notes, chat text or buyer ids."
          },
          "response": []
        },
        {
          "name": "Stall ledger price journeys",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/owner/ledger/journeys",
            "description": "Owner-only ordered item price journeys across listing, price drops, offers, cards, agreements, completed captures and completed refunds. Returns only the narrow journey row shape and no floors, item notes, buyer text, payer data or payment identifiers."
          },
          "response": []
        },
        {
          "name": "Stall ledger config",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/owner/ledger/config",
            "description": "The optional AG Studio licence key, and whether the Stall clerk is on."
          },
          "response": []
        },
        {
          "name": "Check the ledger with PayPal",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/owner/ledger/paypal-check",
            "description": "Owner cookie required. Reads, with the PayPal Agent Toolkit's get_order, each captured order on the stall that has no PayPal read yet, from every session, at most 40 a press, and stores what PayPal said for the ledger's PayPal order read column. Read-only at PayPal and in the records. The answer gives counts, a note and each order's tag codes and outcome, with no PayPal order ids. With nothing left to read it makes no PayPal call and says so. It does not list transactions; the closing check does."
          },
          "response": []
        },
        {
          "name": "Stall clerk turn",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input\": [{ \"type\": \"message\", \"kind\": \"input\", \"role\": \"user\", \"status\": \"completed\", \"content\": [{ \"type\": \"text\", \"text\": \"What are the recorded sales for each session?\" }] }]\n}"
            },
            "url": "{{baseUrl}}/api/owner/ledger/ai",
            "description": "One model turn as newline-delimited events. Spends the ledger's daily allowance. Answers 429 when the allowance, the hourly limit or the limit on turns running at once is reached, and 400 for a tool name outside the server's list."
          },
          "response": []
        }
      ]
    },
