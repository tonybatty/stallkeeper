            ],
            "url": "{{baseUrl}}/api/webhooks/paypal",
            "description": "Paste the exact original signed JSON into the raw body and set all transmission header variables from the same event. An invented body or signature must be rejected. Prefer PayPal dashboard resend; Postman is not evidence of genuine service delivery.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
