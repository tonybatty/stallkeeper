            ],
            "url": "{{baseUrl}}/api/owner/items",
            "description": "askingPence is the owner's expected amount, optional and for the owner's own records: buyer responses send it as null. The optional minimumPence is shown to buyers. Buyers pick their own amount at checkout, up to £500.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Scripted seed tins\",\n  \"notes\": \"Empty, clean tins. Seeded scenario. Four tins with lids.\",\n  \"mode\": \"pwyw\",\n  \"askingPence\": 500,\n  \"minimumPence\": 200\n}",
              "options": {
                "raw": {
