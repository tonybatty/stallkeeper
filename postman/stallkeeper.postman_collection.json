    {
      "name": "Owner stock and tags",
      "item": [
        {
          "name": "Owner login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/owner/login",
            "description": "Local main owner: owner. Local demo owner: demo. Cookie jar stores the owner cookie; hosted passwords are environment-specific.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"{{ownerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Owner stall",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/owner/stall",
            "description": ""
          },
          "response": []
        },
        {
          "name": "List items",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/owner/items",
            "description": ""
          },
          "response": []
        },
        {
          "name": "Preview counter-offer ladder",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/owner/ladder",
            "description": "Owner only and read-only. Returns the counter-offers the server's ladder would issue for these prices. Reads and stores nothing. Returns 400 when the floor is above the asking price. It is a POST so the floor stays out of request logs.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"askingPence\": 2800,\n  \"floorPence\": 2000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Look up comparable new prices (Channel3)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/owner/retail/lookup",
            "description": "Owner only. Searches Channel3 for GBP offers in the UK. Returns 503 when CHANNEL3_API_KEY is unset or Channel3 fails, and 429 after 30 lookups an hour for a stall. Each candidate's reference also carries the listing's `description` (up to 600 characters) and `facts`: up to eight plain-text lines (brand, materials, key features, then structured attributes, each under 120 characters), from the same search response with no extra Channel3 call. A candidate with `missingWords` is a doubtful match and carries an empty description and no facts. The server stores them with the chosen product's reference, and the AI stallholder reads them as the retailer's listing for a new one, apart from the owner's notes. Buyer pages never carry them. Pass a returned productId as retailProductId when creating or editing an item, and the server fetches that product's price itself. Pass retailDoubtful: false with it for a candidate with no `missingWords` so the server stores the listing's details for the AI stallholder. Pass true, or leave it out, and the server stores the price line with no listing details.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"round wall mirror\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Look up comparable new prices from a photo (Channel3)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "image/jpeg"
              }
            ],
            "url": "{{baseUrl}}/api/owner/retail/image-lookup",
            "description": "Owner only. Sends one JPEG of at most 512 KiB to the Stallkeeper API. The server encodes it for Channel3 image search with country GB and currency GBP; the key never reaches the browser. Returns the same candidates as text search, including owner-only used offers and suggested prices based only on an in-stock new GBP offer. Returns 503 when CHANNEL3_API_KEY is unset or Channel3 fails, and 429 after 30 combined text, image and product lookups an hour for a stall. A failure does not block manual pricing.",
            "body": {
              "mode": "file",
              "file": {
                "src": ""
              }
            }
          },
          "response": []
        },
        {
          "name": "Create haggle item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/owner/items",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Scripted brass lamp\",\n  \"notes\": \"Used; scuff on base. Seeded scenario. Owner says it works. Height unknown.\",\n  \"mode\": \"haggle\",\n  \"askingPence\": 2800,\n  \"floorPence\": 1800\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set(\"itemId\", data.id);",
                  "  pm.collectionVariables.set(\"code\", data.code);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create pay-what-you-want item",
          "request": {
