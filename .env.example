# PayPal sandbox REST app client ID used by the API.
PAYPAL_CLIENT_ID=
# PayPal sandbox REST app client secret used by the API.
PAYPAL_CLIENT_SECRET=
# PayPal webhook ID registered for the API listener.
PAYPAL_WEBHOOK_ID=
# Hosted button ID of a sandbox PayPal Donate button, for the Donate button on the closing report. Public, not a secret. Without it the report shows the pledge and no button.
PAYPAL_DONATE_BUTTON_ID=
# Port used by the API locally. The Vite dev proxy follows it. Default 3000.
PORT=
# Postgres connection string. Leave empty locally and `pnpm dev` starts embedded Postgres.
DATABASE_URL=
# Password that opens the main stall.
OWNER_PASSWORD=
# Password that opens the demo stall. It is published for judges, so it must differ from OWNER_PASSWORD.
DEMO_OWNER_PASSWORD=
# Secret that signs owner session cookies.
SESSION_SECRET=
# Public origin used in QR URLs. Leave empty locally and `pnpm dev` uses http://localhost:5173. Required when hosted.
PUBLIC_BASE_URL=
# Anthropic API key (a Console API key). Without it chat and Make an offer stay hidden for haggle items, and the closing summary is not written.
ANTHROPIC_API_KEY=
# Channel3 API key, for comparable new prices when adding an item. Server only. Without it the lookup is off and manual pricing is unchanged.
CHANNEL3_API_KEY=
# Daily AI budget in US dollars. Empty means 3, and 0 turns chat, the closing summary, price reviews and the Stall clerk off.
AI_DAILY_CAP_USD=
# The stall ledger's share of that budget in US dollars. Empty means 1, and 0 turns the Stall clerk off.
AI_LEDGER_DAILY_CAP_USD=
# AG Studio licence key, optional. Never a VITE_ variable. Every owner session can read it, including the demo owner, so use a low-value trial key. Without it the ledger works and shows the trial watermark.
AG_STUDIO_LICENCE_KEY=
# Supabase project URL, used for item photo Storage. Without it photo uploads return 503.
SUPABASE_URL=
# Supabase secret (service role) key for Storage. Server only, never a web variable.
SUPABASE_SERVICE_ROLE_KEY=
# Email of the judge-only PayPal sandbox buyer shown on /demo. Never a personal or live account.
DEMO_BUYER_EMAIL=
# Password of that judge-only sandbox buyer. Both buyer variables must be set for the details to appear.
DEMO_BUYER_PASSWORD=
# Optional https link to the demo film. /demo shows a link to it once this is set.
DEMO_FILM_URL=

# Optional https repository URL for the README link on /demo.
DEMO_REPO_URL=https://github.com/tonybatty/stallkeeper
